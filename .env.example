# Hisab — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_NAME=Hisab
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev (zero setup): sqlite:///./hisab.db
# Docker (PostgreSQL 16): postgresql+psycopg2://hisab:hisab@db:5432/hisab
DATABASE_URL=sqlite:///./hisab.db

# --- CORS ---
# Comma-separated origins allowed to call the API. "*" allows all (dev only).
CORS_ORIGINS=*

# --- Money ---
# Default USD→PKR conversion rate used for income reports.
DEFAULT_USD_TO_PKR=280.0
